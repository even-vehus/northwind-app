# Copy to .env.local and fill in your values:  Copy-Item .env.example .env.local
# (local dev without Docker — Vite reads VITE_* vars at dev/build time)

VITE_API_BASE_URL=http://localhost:5298
# Leave VITE_ENTRA_CLIENT_ID commented to use the POC dummy sign-in.
# VITE_ENTRA_CLIENT_ID=<spa-app-client-id>   ← fill in when Azure AD is configured
# VITE_ENTRA_TENANT_ID=<tenant-guid>         ← fill in when Azure AD is configured
# VITE_ENTRA_API_SCOPE=api://<api-app-client-id>/access_as_user
