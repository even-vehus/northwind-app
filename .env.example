# Copy to .env and fill in your values.

# ── Fabric SQL ───────────────────────────────────────────────────────────────
# ADO.NET connection string from the Fabric portal (Settings → Connection string)
CONNECTIONSTRINGS__FABRICSQL=Server=<your-fabric-endpoint>.datawarehouse.fabric.microsoft.com;Initial Catalog=<your-db>;Authentication=Active Directory Default;Encrypt=True;

# ── Entra ID (backend) ───────────────────────────────────────────────────────
AZUREAD__TENANTID=<your-tenant-id>
AZUREAD__CLIENTID=<your-api-app-registration-client-id>
# Audience must match the API app registration (Application ID URI)
AZUREAD__AUDIENCE=api://<your-api-app-registration-client-id>

# ── Entra ID (frontend) ──────────────────────────────────────────────────────
VITE_ENTRA_TENANT_ID=<your-tenant-id>
VITE_ENTRA_CLIENT_ID=<your-spa-app-registration-client-id>

# ── API URL (frontend) ───────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000

# ── CORS (backend) ───────────────────────────────────────────────────────────
ALLOWEDORIGINS__0=http://localhost:5173
