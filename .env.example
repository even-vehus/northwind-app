# Copy to .env and fill in your values:  Copy-Item .env.example .env
# Used by docker-compose.yml (and as a reference for backend appsettings.Development.json).

# ── Fabric SQL ───────────────────────────────────────────────────────────────
# ADO.NET connection string from the Fabric portal (Settings → Connection string)
CONNECTIONSTRINGS__FABRICSQL=Data Source=<fabric-host>,1433;Initial Catalog=<catalog>;Encrypt=True;Authentication=Active Directory Default

# ── Entra ID (backend) ───────────────────────────────────────────────────────
# Leave AZUREAD__CLIENTID commented to BYPASS auth (POC default).
# Uncomment + fill to enable Entra ID JWT validation.
AZUREAD__TENANTID=<tenant-guid>
# AZUREAD__CLIENTID=<api-app-client-id>
# Audience must match the API app registration (Application ID URI)
AZUREAD__AUDIENCE=api://<api-app-client-id>

# ── Entra ID (frontend) ──────────────────────────────────────────────────────
# Leave VITE_ENTRA_CLIENT_ID commented to use the POC dummy sign-in.
VITE_ENTRA_TENANT_ID=<tenant-guid>
# VITE_ENTRA_CLIENT_ID=<spa-app-client-id>
# Scope of the API app (audience must match AZUREAD__AUDIENCE above)
VITE_ENTRA_API_SCOPE=api://<api-app-client-id>/access_as_user

# ── API URL (frontend) ───────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000

# ── CORS (backend) ───────────────────────────────────────────────────────────
ALLOWEDORIGINS__0=http://localhost:5173
